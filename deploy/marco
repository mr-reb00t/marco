#!/usr/bin/env bash
# marco: manage a Marco install made with install.sh (https://marcohome.app/install).
#
#   marco status            service state, version, address
#   marco logs [-f]         server log (-f follows it); on a kiosk-only device, the kiosk log
#   marco restart           restart the server
#   marco update [--force]  install the latest release (rolled back if it does not start; --force reinstalls)
#                           (`marco update --requested` is run by marco-update.service for an update started in the admin)
#   marco url               admin address and the private link of every screen, with QR codes
#   marco version           installed version and the latest release
#   marco power on|off|status  whether the "Shut down" card on a screen of this device may power it off
#   marco kiosk [start|stop]   open the kiosk again in the desktop session (after "Exit kiosk"); stop closes it
#   marco uninstall [--purge]  remove Marco; your data is kept unless you add --purge
set -euo pipefail

CONF="${MARCO_CONF:-/etc/marco.conf}"   # MARCO_CONF: testing only
INSTALLER=/usr/local/lib/marco/install.sh
SERVICE=marco

if [ -t 1 ]; then C_B=$'\033[1m'; C_DIM=$'\033[2m'; C_RE=$'\033[1;31m'; C_GR=$'\033[1;32m'; C_0=$'\033[0m'
else C_B=""; C_DIM=""; C_RE=""; C_GR=""; C_0=""; fi
die() { printf '%sError:%s %s\n' "$C_RE" "$C_0" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -r "$CONF" ] || die "Marco is not installed here ($CONF not found). Install it: curl -fsSL https://marcohome.app/install | bash"
MARCO_MODE=server; MARCO_LAYOUT=release; MARCO_DIR=""; MARCO_USER=""; MARCO_NODE=""; MARCO_REPO="mr-reb00t/marco"
MARCO_RELEASES_URL=""
# shellcheck disable=SC1090
. "$CONF"

if [ "$MARCO_LAYOUT" = checkout ]; then APP="$MARCO_DIR"; else APP="$MARCO_DIR/current"; fi
ENV_FILE="$MARCO_DIR/.env"
NODE="${MARCO_NODE:-$(command -v node || echo node)}"

root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
as_owner() { # runs a command as the service user (it owns the data folder)
  if [ "$(id -un)" = "$MARCO_USER" ]; then "$@"
  elif [ "$(id -u)" -eq 0 ]; then runuser -u "$MARCO_USER" -- "$@"
  else sudo -u "$MARCO_USER" "$@"; fi
}
env_get() { [ -r "$ENV_FILE" ] || return 0; grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d "\"' " || true; }
port() { local p; p="$(env_get PORT 2>/dev/null || true)"; printf '%s' "${p:-3000}"; }
lan_ip() {
  local ip
  ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -vE '^(127\.|172\.(1[7-9]|2[0-9]|3[01])\.)' | head -n1 || true)"
  printf '%s' "${ip:-localhost}"
}
installed_version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$APP/package.json" 2>/dev/null | head -n1; }
latest_version() {
  local loc
  loc="$(curl -fsSI --connect-timeout 10 "${MARCO_RELEASES_URL:-https://github.com/${MARCO_REPO}/releases}/latest" 2>/dev/null | tr -d '\r' | sed -n 's/^[Ll]ocation: *//p' | tail -n1 || true)"
  case "$loc" in */releases/tag/v*) printf '%s' "${loc##*/tag/v}" ;; esac
}
qr() {
  if have qrencode; then qrencode -t ANSIUTF8 -m 2 "$1"
  else printf '%s(install qrencode to show a QR code here: sudo apt install qrencode)%s\n' "$C_DIM" "$C_0"; fi
}
need_server() { [ "$MARCO_MODE" != kiosk ] || die "This device only runs the kiosk (screen); the server is elsewhere."; }

cmd_status() {
  echo "${C_B}Marco${C_0} ($MARCO_MODE, $MARCO_DIR)"
  if [ "$MARCO_MODE" != kiosk ]; then
    echo "  Version:  $(installed_version)"
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then echo "  Service:  ${C_GR}running${C_0}"
    else echo "  Service:  ${C_RE}$(systemctl is-active "$SERVICE" 2>/dev/null || echo 'not running')${C_0}"; fi
    if curl -fsS --max-time 3 "http://127.0.0.1:$(port)/api/health" >/dev/null 2>&1; then echo "  Health:   ok"
    else echo "  Health:   ${C_RE}not answering${C_0} on port $(port)"; fi
    echo "  Admin:    http://$(lan_ip):$(port)/admin/"
    echo "  Power:    $(power_state)"
  fi
  if [ "$MARCO_MODE" != server ]; then
    if kiosk_running "$(user_rt)"; then echo "  Kiosk:    running"
    elif [ -e "$(user_rt)/marco-kiosk.closed" ]; then echo "  Kiosk:    closed from the screen (start it again: marco kiosk)"
    else echo "  Kiosk:    not running (start it: marco kiosk)"; fi
  fi
}

cmd_logs() {
  if [ "$MARCO_MODE" = kiosk ]; then
    if [ "${1:-}" = "-f" ]; then exec tail -f /tmp/marco-kiosk.log; fi
    exec tail -n 100 /tmp/marco-kiosk.log
  fi
  local j=(journalctl)
  # Reading the system journal needs root or the adm / systemd-journal group.
  if [ "$(id -u)" -ne 0 ] && ! id -nG | grep -qwE 'adm|systemd-journal'; then j=(sudo journalctl); fi
  if [ "${1:-}" = "-f" ]; then exec "${j[@]}" -u "$SERVICE" -f -n 50; fi
  exec "${j[@]}" -u "$SERVICE" -n 200 --no-pager
}

cmd_url() {
  need_server
  local base admin
  base="http://$(lan_ip):$(port)"
  admin="$base/admin/"
  echo "${C_B}Admin${C_0}  $admin"
  qr "$admin"
  # The data folder belongs to the service user (secrets.json is private): read it as that user.
  local lines
  # shellcheck disable=SC2016
  lines="$(cd / && as_owner "$NODE" -e '
    const fs = require("fs"), path = require("path");
    const [dir, base] = process.argv.slice(1);
    let cfg, sec = {};
    try { cfg = JSON.parse(fs.readFileSync(path.join(dir, "config.json"), "utf8")); } catch { process.exit(3); }
    try { sec = JSON.parse(fs.readFileSync(path.join(dir, "secrets.json"), "utf8")); } catch {}
    const priv = (cfg.security || {}).displayAccess === "private";
    for (const s of Array.isArray(cfg.screens) ? cfg.screens : []) {
      const key = ((sec.displayKeys || {})[s.id] || {}).key;
      const url = priv ? (key ? `${base}/d/${key}` : "") : `${base}/?screen=${encodeURIComponent(s.slug || s.id)}`;
      console.log([s.name || s.id, url, priv ? "private" : "open"].join("\t"));
    }
  ' "$MARCO_DIR/data" "$base" 2>/dev/null)" || { echo "No screens yet: finish the setup wizard first."; return 0; }
  local name url mode
  while IFS=$'\t' read -r name url mode; do
    [ -n "$name" ] || continue
    echo
    if [ -z "$url" ]; then echo "${C_B}Screen: $name${C_0}  (no private link yet: open it in the admin, Screen > Settings)"; continue; fi
    echo "${C_B}Screen: $name${C_0}  $url"
    if [ "$mode" = private ]; then echo "${C_DIM}Private link: anyone with it can see this screen. Do not post it publicly.${C_0}"; fi
    qr "$url"
  done <<< "$lines"
}

# The "Shut down" card: on when marco-power.path runs (install.sh install_power_units).
power_state() {
  if systemctl is-active --quiet marco-power.path 2>/dev/null; then echo "on (the Shut down card may power off this device)"
  elif [ -f /etc/systemd/system/marco-power.path ]; then echo "${C_RE}installed but not running${C_0} (sudo marco power on)"
  else echo "off (turn on: sudo marco power on)"; fi
}

cmd_power() {
  need_server
  case "${1:-status}" in
    on|off) installer --power-units "$1" ;;
    status) echo "Shut down card: $(power_state)" ;;
    *) die "Usage: marco power on|off|status" ;;
  esac
}

# ---- Kiosk -----------------------------------------------------------------------------------------------------
# The kiosk (deploy/kiosk.sh, or ~/.local/bin/marco-kiosk on a screen-only device) runs in the desktop session of
# MARCO_USER, started by its autostart. `marco kiosk` starts it again there, from a terminal on the device or over SSH.
KIOSK_RE='(\.local/bin/marco-kiosk|deploy/kiosk\.sh)( |$)'
RUN_DIR="${MARCO_RUN_DIR:-/run/marco}"
owner_home() {
  if [ "$(id -un)" = "$MARCO_USER" ] && [ -n "${HOME:-}" ]; then printf '%s' "$HOME"
  else getent passwd "$MARCO_USER" | cut -d: -f6; fi
}
user_rt() {
  if [ "$(id -un)" = "$MARCO_USER" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then printf '%s' "$XDG_RUNTIME_DIR"
  else printf '/run/user/%s' "$(id -u "$MARCO_USER" 2>/dev/null || echo none)"; fi
}
kiosk_cmd() {
  case "$MARCO_MODE" in
    all) printf '%s' "$APP/deploy/kiosk.sh" ;;
    kiosk) printf '%s' "$(owner_home)/.local/bin/marco-kiosk" ;;
    *) die "This device has no kiosk (server only)." ;;
  esac
}
# kiosk_running [runtime folder]: its process, or its lock (kiosk.sh holds <runtime folder>/marco-kiosk.lock)
kiosk_running() {
  pgrep -u "$MARCO_USER" -f "$KIOSK_RE" >/dev/null 2>&1 && return 0
  local lock="${1:-/tmp}/marco-kiosk.lock"
  [ -r "$lock" ] && have flock && ! flock -n "$lock" true 2>/dev/null
}

# desktop_env: the desktop session of MARCO_USER (S_ID, S_WAYLAND, S_DISPLAY, S_XAUTH, S_RT, S_DBUS). The session id
# matters: a close from the screen is kept for that session, and an autostart line the desktop runs again must match it.
desktop_env() {
  local uid pid e sid type state rt s
  S_ID=""; S_WAYLAND=""; S_DISPLAY=""; S_XAUTH=""; S_RT=""; S_DBUS=""
  uid="$(id -u "$MARCO_USER")"
  # 1. A terminal in that desktop (an X display forwarded over SSH, localhost:10, is not it)
  if [ "$(id -un)" = "$MARCO_USER" ] && { [ -n "${WAYLAND_DISPLAY:-}" ] || [[ "${DISPLAY:-}" == :* ]]; }; then
    S_ID="${XDG_SESSION_ID:-}"; S_WAYLAND="${WAYLAND_DISPLAY:-}"; S_RT="${XDG_RUNTIME_DIR:-}"
    if [ -z "$S_WAYLAND" ]; then S_DISPLAY="$DISPLAY"; S_XAUTH="${XAUTHORITY:-}"; fi
    S_DBUS="${DBUS_SESSION_BUS_ADDRESS:-}"
    return 0
  fi
  # 2. A process of that desktop (the panel, the file manager...) carries its environment
  for pid in $(pgrep -u "$uid" 2>/dev/null || true); do
    e="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null)" || continue
    case "$(printf '%s\n' "$e" | sed -n 's/^XDG_SESSION_TYPE=//p' | head -n1)" in wayland|x11) ;; *) continue ;; esac
    S_WAYLAND="$(printf '%s\n' "$e" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n1)"
    S_DISPLAY="$(printf '%s\n' "$e" | sed -n 's/^DISPLAY=//p' | head -n1)"
    if [ -z "$S_WAYLAND" ] && [ -z "$S_DISPLAY" ]; then continue; fi
    S_ID="$(printf '%s\n' "$e" | sed -n 's/^XDG_SESSION_ID=//p' | head -n1)"
    S_XAUTH="$(printf '%s\n' "$e" | sed -n 's/^XAUTHORITY=//p' | head -n1)"
    S_RT="$(printf '%s\n' "$e" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n1)"
    S_DBUS="$(printf '%s\n' "$e" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n1)"
    if [ -n "$S_WAYLAND" ]; then S_DISPLAY=""; S_XAUTH=""; fi
    return 0
  done
  # 3. logind: a graphical session of that user, its display or Wayland socket
  if have loginctl; then
    for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$MARCO_USER" '$3 == u { print $1 }' || true); do
      type="$(loginctl show-session "$sid" -p Type --value 2>/dev/null || true)"
      state="$(loginctl show-session "$sid" -p State --value 2>/dev/null || true)"
      [ "$state" != closing ] || continue
      rt="/run/user/$uid"
      case "$type" in
        wayland)
          for s in "$rt"/wayland-[0-9]*; do
            case "$s" in *.lock) continue ;; esac
            if [ -S "$s" ]; then S_WAYLAND="${s##*/}"; break; fi
          done
          [ -n "$S_WAYLAND" ] || continue ;;
        x11)
          S_DISPLAY="$(loginctl show-session "$sid" -p Display --value 2>/dev/null || true)"
          if [ -z "$S_DISPLAY" ] && [ -S /tmp/.X11-unix/X0 ]; then S_DISPLAY=":0"; fi
          [ -n "$S_DISPLAY" ] || continue
          if [ -f "$(owner_home)/.Xauthority" ]; then S_XAUTH="$(owner_home)/.Xauthority"; fi ;;
        *) continue ;;
      esac
      S_ID="$sid"
      if [ -d "$rt" ]; then S_RT="$rt"; fi
      if [ -S "$rt/bus" ]; then S_DBUS="unix:path=$rt/bus"; fi
      return 0
    done
  fi
  die "No desktop session of $MARCO_USER is running, so the kiosk has nowhere to open. Log in to the desktop on this device (or turn on desktop auto-login: sudo raspi-config, System Options, Auto Login), or restart it: sudo reboot. The kiosk starts with the desktop session."
}

cmd_kiosk() {
  case "${1:-start}" in
    start) kiosk_start ;;
    stop) kiosk_stop ;;
    *) die "Usage: marco kiosk [start|stop]" ;;
  esac
}

kiosk_start() {
  local cmd log="${KIOSK_LOG:-/tmp/marco-kiosk.log}" envs _
  cmd="$(kiosk_cmd)"
  [ -f "$cmd" ] || die "$cmd is missing. Run the installer again: marco update --force"
  if kiosk_running "$(user_rt)"; then echo "Kiosk: already running (marco kiosk stop closes it)."; return 0; fi
  have setsid || die "setsid is missing (util-linux)."
  desktop_env
  if kiosk_running "${S_RT:-/tmp}"; then echo "Kiosk: already running (marco kiosk stop closes it)."; return 0; fi
  # Only that session's variables: an SSH login's own display or session id would open it in the wrong place, or
  # keep a later close from the screen from holding (kiosk.sh compares the session id).
  envs=(HOME="$(owner_home)" USER="$MARCO_USER" LOGNAME="$MARCO_USER")
  if [ -n "$S_RT" ]; then envs+=(XDG_RUNTIME_DIR="$S_RT"); fi
  if [ -n "$S_ID" ]; then envs+=(XDG_SESSION_ID="$S_ID"); fi
  if [ -n "$S_WAYLAND" ]; then envs+=(WAYLAND_DISPLAY="$S_WAYLAND"); fi
  if [ -n "$S_DISPLAY" ]; then envs+=(DISPLAY="$S_DISPLAY"); fi
  if [ -n "$S_XAUTH" ]; then envs+=(XAUTHORITY="$S_XAUTH"); fi
  if [ -n "$S_DBUS" ]; then envs+=(DBUS_SESSION_BUS_ADDRESS="$S_DBUS"); fi
  # --open: a close from the screen no longer holds it back. Not started from a terminal, kiosk.sh writes its own log.
  as_owner env -u XDG_RUNTIME_DIR -u XDG_SESSION_ID -u WAYLAND_DISPLAY -u DISPLAY -u XAUTHORITY -u DBUS_SESSION_BUS_ADDRESS \
    "${envs[@]}" setsid -f bash "$cmd" --open </dev/null >/dev/null 2>&1 || die "Could not start $cmd"
  for _ in $(seq 1 25); do kiosk_running "${S_RT:-/tmp}" && break; sleep 0.2; done
  sleep 1
  if ! kiosk_running "${S_RT:-/tmp}"; then
    echo "The kiosk stopped right away. Its log ($log):" >&2
    tail -n 15 "$log" 2>/dev/null >&2 || true
    exit 1
  fi
  echo "Kiosk started${S_WAYLAND:+ on $S_WAYLAND}${S_DISPLAY:+ on display $S_DISPLAY}. Chromium opens once the server answers."
  echo "Log: $log"
}

# On an all-in-one device the same way as the "Exit kiosk" card (a new number in /run/marco/kiosk-exit): the browser
# closes with all its processes, and a desktop that starts the kiosk again keeps it closed for this session.
kiosk_stop() {
  local _
  kiosk_cmd >/dev/null
  if ! kiosk_running "$(user_rt)"; then echo "Kiosk: not running."; return 0; fi
  if [ "$MARCO_MODE" = all ] && [ -d "$RUN_DIR" ]; then
    # shellcheck disable=SC2016
    as_owner sh -c 'rm -f "$1/.kiosk-exit.tmp" && (umask 022; date +%s%3N > "$1/.kiosk-exit.tmp") && mv -f "$1/.kiosk-exit.tmp" "$1/kiosk-exit"' sh "$RUN_DIR" \
      || die "Could not write $RUN_DIR/kiosk-exit"
  else
    # a screen-only device: kiosk.sh closes the browser when it is stopped (a desktop that runs it again opens it again)
    as_owner pkill -TERM -u "$MARCO_USER" -f "$KIOSK_RE" || true
  fi
  for _ in $(seq 1 30); do
    if ! kiosk_running "$(user_rt)"; then echo "Kiosk closed. Open it again: marco kiosk"; return 0; fi
    sleep 0.5
  done
  die "The kiosk is still running after 15 s. Its log: ${KIOSK_LOG:-/tmp/marco-kiosk.log}"
}

cmd_version() {
  local cur latest
  if [ "$MARCO_MODE" = kiosk ]; then cur="kiosk only"; else cur="$(installed_version)"; fi
  latest="$(latest_version)"
  echo "Installed: ${cur:-unknown}"
  echo "Latest:    ${latest:-no release published yet}"
}

installer() {
  [ -x "$INSTALLER" ] || die "$INSTALLER is missing. Run the installer again: curl -fsSL https://marcohome.app/install | bash"
  # MARCO_RELEASES_URL (testing only) comes from /etc/marco.conf, which only root can change.
  if [ -n "$MARCO_RELEASES_URL" ]; then export MARCO_RELEASES_URL; fi
  exec bash "$INSTALLER" "$@"
}

# marco update --requested: run by marco-update.service (root) when the admin asked for an update. The data folder
# belongs to the service user, so everything written there is written as that user (a link planted in that folder
# cannot make root overwrite another file), and nothing in the request is used except that it exists.
cmd_update_requested() {
  [ "$(id -u)" -eq 0 ] || die "marco update --requested is run by the marco-update service (as root)."
  local udir="$MARCO_DIR/data/update" req from to rc by=admin state rolled=false target=""
  req="$udir/request"
  [ -e "$req" ] || [ -L "$req" ] || { echo "No update requested."; return 0; }
  if [ -f "$req" ] && [ ! -L "$req" ]; then
    case "$(head -c 300 "$req" 2>/dev/null || true)" in *'"by":"auto"'*) by=auto ;; esac
    target="$(head -c 300 "$req" 2>/dev/null | sed -n 's/.*"target":"\([0-9A-Za-z.+-]*\)".*/\1/p' | head -n1 || true)"
  fi
  rm -rf "$req"
  if [ "$MARCO_LAYOUT" != release ] || [ "$MARCO_MODE" = kiosk ]; then
    write_status failed "$(installed_version)" "" "$by" false "$target"
    die "Updates from the admin need a release install (this one is: $MARCO_LAYOUT, $MARCO_MODE)."
  fi
  from="$(installed_version)"
  write_status running "$from" "" "$by" false "$target"
  echo "Update requested from the admin ($by): Marco $from, latest release ${target:-unknown}"
  [ -x "$INSTALLER" ] || { write_status failed "$from" "" "$by" false "$target"; die "$INSTALLER is missing."; }
  if [ -n "$MARCO_RELEASES_URL" ]; then export MARCO_RELEASES_URL; fi
  set +e
  bash "$INSTALLER" --update --yes --dir "$MARCO_DIR" --mode "$MARCO_MODE" --user "$MARCO_USER" 2>&1 \
    | as_owner tee "$udir/update.log"
  rc="${PIPESTATUS[0]}"
  set -e
  to="$(installed_version)"
  if [ "$rc" = 0 ] && [ "$to" != "$from" ]; then state="done"
  elif [ "$rc" = 0 ]; then state="current"
  else
    state=failed
    if [ "$to" = "$from" ]; then rolled=true; fi
  fi
  write_status "$state" "$from" "$to" "$by" "$rolled" "$target"
  echo "Update finished: $state (from $from to ${to:-?})"
  [ "$state" != failed ] || exit 1
}

# write_status <state> <from> <to> <by> <rolledBack> <target>: <data>/update/status.json, written as the service user
write_status() {
  local udir="$MARCO_DIR/data/update" clean=() v
  for v in "$@"; do clean+=("$(printf '%s' "$v" | tr -cd '0-9A-Za-z.+-')"); done
  as_owner mkdir -p "$udir" 2>/dev/null || true
  printf '{"state":"%s","from":"%s","to":"%s","by":"%s","rolledBack":%s,"target":"%s","at":"%s"}\n' \
    "${clean[0]}" "${clean[1]}" "${clean[2]}" "${clean[3]}" "${clean[4]}" "${clean[5]}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    | as_owner tee "$udir/.status.json.tmp" >/dev/null || return 0
  as_owner mv -f "$udir/.status.json.tmp" "$udir/status.json" || true
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed -e '/^set -euo/d' -e 's/^# \{0,1\}//'; }

case "${1:-}" in
  status) cmd_status ;;
  logs) shift; cmd_logs "$@" ;;
  restart) need_server; root systemctl restart "$SERVICE" && echo "Restarted." ;;
  update)
    shift
    if [ "${1:-}" = --requested ]; then cmd_update_requested
    else installer --update --yes --dir "$MARCO_DIR" --mode "$MARCO_MODE" --user "$MARCO_USER" "$@"; fi ;;
  url|urls|links) cmd_url ;;
  version|--version|-v) cmd_version ;;
  power) shift; cmd_power "$@" ;;
  kiosk) shift; cmd_kiosk "$@" ;;
  uninstall) shift; installer --uninstall --dir "$MARCO_DIR" "$@" ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
