# systemd unit for Marco.
# install.sh replaces @USER@, @GROUP@, @APP_DIR@, @DATA_DIR@, @ENV_FILE@ and @NODE@ and copies it to
# /etc/systemd/system/marco.service. Settings in the .env file override the Environment= lines.
[Unit]
Description=Marco (wall calendar display + admin panel)
Documentation=file://@APP_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
Environment=DATA_DIR=@DATA_DIR@
EnvironmentFile=-@ENV_FILE@
ExecStart=@NODE@ server/index.js
Restart=always
RestartSec=5
# Bounded memory so Chromium on the same Pi has room
Environment=NODE_OPTIONS=--max-old-space-size=256
# /run/marco (owned by @USER@, readable by everyone, gone at every boot): the "Salir del kiosko" and "Apagar" cards
# leave their requests there for deploy/kiosk.sh and marco-power.path (server/power.js)
RuntimeDirectory=marco
RuntimeDirectoryMode=0755
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=marco

[Install]
WantedBy=multi-user.target
