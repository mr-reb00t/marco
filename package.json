{
  "name": "marco",
  "version": "0.17.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted family wall calendar & dashboard for a Raspberry Pi kiosk or any browser: Google Calendar, iCal, weather, photos, announcements. A free, open-source DAKboard alternative.",
  "license": "MIT",
  "keywords": [
    "calendar",
    "dashboard",
    "wall-display",
    "raspberry-pi",
    "kiosk",
    "dakboard",
    "family-calendar",
    "home-assistant",
    "self-hosted",
    "google-calendar",
    "ical"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --test-force-exit --test-timeout=1800000 server/test/*.test.js",
    "demo": "node scripts/demo.js",
    "check:release": "node scripts/check-release.js",
    "contract": "node scripts/gen-contract.mjs",
    "disable-2fa": "node server/disable-2fa.js"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "multer": "^2.4.0",
    "node-ical": "^0.27.3",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "heic-to": "^1.6.5",
    "preact": "^11.0.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
